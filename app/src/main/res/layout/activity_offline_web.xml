<!-- res/layout/activity_main.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

     <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


     <LinearLayout
         android:id="@+id/loaderLayout"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:layout_gravity="center"
         android:gravity="center"
         android:orientation="vertical"
         android:background="#fff">

          <ImageView
              android:id="@+id/loading_indicator"
              android:layout_width="200dp"
              android:layout_height="100dp"
              android:visibility="visible"
              android:layout_gravity="center"
              android:layout_marginRight="10dp"
              android:src="@drawable/loader"
              android:scaleType="fitCenter" />


          <TextView
              android:id="@+id/download_text_per"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Download in progress"
              android:layout_gravity="center"
              android:textStyle="bold"
              android:textSize="24sp"
              android:gravity="center"
              android:textColor="#000">

          </TextView>

     </LinearLayout>

<FrameLayout
    android:id="@+id/connectionIndicatorContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
     android:layout_marginStart="50dp"
     >

    <LinearLayout
        android:id="@+id/connectionIndicator"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="18dp"
        android:background="@drawable/indicator_online_bg"
        android:elevation="0dp"
        android:animateLayoutChanges="true">

        <TextView
            android:id="@+id/indicatorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOADED ONLINE 😃"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"/>

        <ImageView
            android:id="@+id/indicatorIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="#00FF00"/>
    </LinearLayout>
</FrameLayout>
 </FrameLayout>
